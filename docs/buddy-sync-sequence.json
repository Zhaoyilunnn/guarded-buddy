{
  "title": "buddy sync and wr run across devices",
  "participants": [
    {"id": "user", "label": "User", "actor": true},
    {"id": "buddy", "label": "buddy CLI"},
    {"id": "local", "label": "Current device HOME"},
    {"id": "archive", "label": "Device archive"},
    {"id": "provider", "label": "External sync provider"},
    {"id": "collect", "label": "Weekly report collector"},
    {"id": "llm", "label": "AI CLI / API"}
  ],
  "messages": [
    {"from": "user", "to": "buddy", "label": "buddy sync"},
    {"from": "buddy", "to": "local", "label": "Scan supported raw history files"},
    {"from": "buddy", "to": "archive", "label": "Read the device manifest"},
    {"from": "buddy", "to": "local", "label": "Compute content digests"},
    {"from": "buddy", "to": "archive", "label": "Atomically create or update changed files"},
    {"from": "buddy", "to": "archive", "label": "Atomically update the manifest"},
    {"from": "archive", "to": "provider", "label": "External product replicates the folder", "async": true},
    {"from": "buddy", "to": "user", "label": "Print created / updated / skipped / failed", "return": true},
    {"note": "With [sync] configured, wr run performs sync first; --no-sync skips it", "over": "buddy"},
    {"from": "user", "to": "buddy", "label": "buddy wr run"},
    {"from": "buddy", "to": "collect", "label": "Read current HOME + devices/*/home"},
    {"from": "collect", "to": "collect", "label": "Deduplicate sessions and messages"},
    {"from": "collect", "to": "buddy", "label": "Create daily Markdown for the date range", "return": true},
    {"from": "buddy", "to": "llm", "label": "Submit the weekly-report prompt"},
    {"from": "llm", "to": "buddy", "label": "Return the weekly report", "return": true},
    {"from": "buddy", "to": "user", "label": "Write report.md", "return": true}
  ]
}
